ounded=0;endArrow=classic;startArrow=none;strokeWidth=2;strokeColor=#6B7280;endFill=1;startFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="756" y="590" as="sourcePoint"/><mxPoint x="200" y="594" as="targetPoint"/><Array as="points"><mxPoint x="700" y="590"/><mxPoint x="700" y="620"/><mxPoint x="200" y="620"/></Array></mxGeometry></mxCell><mxCell id="c38" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6B7280;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="436" y="606" width="28" height="28" as="geometry"/></mxCell><mxCell id="c39" value="respuesta al cliente (sendMessage)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="470" y="628" width="280" height="24" as="geometry"/></mxCell><mxCell id="c40" style="html=1;rounded=0;endArrow=classic;startArrow=none;strokeWidth=2;strokeColor=#374151;endFill=1;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="828" y="852" as="sourcePoint"/><mxPoint x="1126" y="852" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="963" y="838" width="28" height="28" as="geometry"/></mxCell><mxCell id="c42" value="Stream: pedido nuevo" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="890" y="822" width="180" height="20" as="geometry"/></mxCell><mxCell id="c43" style="html=1;rounded=0;endArrow=classic;startArrow=none;strokeWidth=2;strokeColor=#C0392B;endFill=1;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1196" y="852" as="sourcePoint"/><mxPoint x="