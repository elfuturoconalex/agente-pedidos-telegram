fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="1078" width="1650" height="26" as="geometry"/></mxCell><mxCell id="c50" value="Flujo: 1-2 el cliente escribe · 3 la recepción revisa la clave · 4 la fila ordena · 5-6 el agente piensa y guarda · 7 contesta · 8-9 el Stream despierta a la avisadora." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="1106" width="1650" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>