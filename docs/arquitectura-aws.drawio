<mxfile host="app.diagrams.net"><diagram id="agente3" name="Agente 3 - AWS"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Agente #3 · Pedidos por Telegram · Arquitectura en AWS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c2" value="El cliente pide en lenguaje natural; el agente pregunta lo que falta, confirma y guarda el pedido. Don Chuy recibe un aviso de cada pedido y consulta pendientes y ventas." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1650" height="30" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FDF3E1;strokeColor=#E8762C;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="140" width="1210" height="890" as="geometry"/></mxCell><mxCell id="c4" value="AWS · us-east-1 · todo como código (Terraform)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=0;fontColor=#C2410C;" vertex="1" parent="1"><mxGeometry x="345" y="148" width="600" height="36" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;br&gt;&quot;Quiero 2 kg de tortilla&lt;br&gt;y un refresco&quot;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="130" y="260" width="64" height="64" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Telegram&lt;/b&gt;&lt;br&gt;Bot API (gratis)&lt;br&gt;avisa por webhook" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#229ED9;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;" vertex="1" parent="1"><mxGeometry x="130" y="470" width="64" height="64" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Don Chuy (dueño)&lt;/b&gt;&lt;br&gt;/pendientes · /ventas&lt;br&gt;/entregado" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="130" y="820" width="64" height="64" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Parameter Store&lt;/b&gt;&lt;br&gt;token del bot y secreto del&lt;br&gt;webhook (cifrados) y&lt;br&gt;chat_id del dueño" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#E7157B;resIcon=mxgraph.aws4.systems_manager;" vertex="1" parent="1"><mxGeometry x="430" y="230" width="64" height="64" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;HTTP API · POST /telegram&lt;br&gt;10 por seg (ráfaga 20)" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#E7157B;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="430" y="470" width="64" height="64" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Lambda · recepción&lt;/b&gt;&lt;br&gt;revisa la clave secreta de Telegram,&lt;br&gt;mete el mensaje a la fila&lt;br&gt;y responde 200 al instante" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#ED7100;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="760" y="230" width="64" height="64" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;SQS FIFO + DLQ&lt;/b&gt; (ADR 002)&lt;br&gt;orden por cliente · sin duplicados&lt;br&gt;3 intentos y luego a la DLQ" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=middle;verticalAlign=middle;labelPosition=right;align=left;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#E7157B;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1"><mxGeometry x="760" y="400" width="64" height="64" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Lambda · agente de pedidos&lt;/b&gt;&lt;br&gt;Claude decide → herramientas&lt;br&gt;el código lleva catálogo, precios y totales&lt;br&gt;la guardia frena un &quot;confirmado&quot; falso&lt;br&gt;comandos del dueño: datos exactos, sin IA" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#ED7100;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="760" y="530" width="64" height="64" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;Claude Haiku 4.5&lt;br&gt;perfil Global · Converse" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#01A88D;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="1130" y="530" width="64" height="64" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;CloudWatch&lt;/b&gt;&lt;br&gt;TRAZA: tokens, costo, paradas&lt;br&gt;2 alarmas en filas de fallas" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#E7157B;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="1130" y="230" width="64" height="64" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;DynamoDB · tabla única&lt;/b&gt; (ADR 001)&lt;br&gt;pláticas (24 h), pedidos y folio&lt;br&gt;ventas por semana y mes&lt;br&gt;GSI1: pendientes · Stream encendido" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#C925D1;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="760" y="820" width="64" height="64" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Lambda · avisadora&lt;/b&gt; (ADR 003)&lt;br&gt;solo pedidos nuevos&lt;br&gt;palomita &quot;avisado&quot;&lt;br&gt;mensaje a Don Chuy" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#ED7100;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1130" y="820" width="64" height="64" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;SQS avisos fallidos&lt;/b&gt;&lt;br&gt;si falla 3 veces" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#E7157B;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1"><mxGeometry x="1380" y="820" width="64" height="64" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Amazon SNS → correo&lt;/b&gt;&lt;br&gt;ALARM y OK" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#E7157B;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1"><mxGeometry x="1600" y="230" width="64" height="64" as="geometry"/></mxCell><mxCell id="c19" value="Rol de IAM por Lambda&lt;br&gt;mínimo privilegio · sin llaves" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=middle;verticalAlign=middle;labelPosition=right;align=left;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.role;" vertex="1" parent="1"><mxGeometry x="1300" y="960" width="40" height="40" as="geometry"/></mxCell><mxCell id="c20" style="html=1;rounded=0;endArrow=classic;startArrow=classic;strokeWidth=2;strokeColor=#374151;endFill=1;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="162" y="340" as="sourcePoint"/><mxPoint x="162" y="466" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="148" y="389" width="28" height="28" as="geometry"/></mxCell><mxCell id="c22" style="html=1;rounded=0;endArrow=classic;startArrow=classic;strokeWidth=2;strokeColor=#374151;endFill=1;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="590" as="sourcePoint"/><mxPoint x="140" y="816" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" style="html=1;rounded=0;endArrow=classic;startArr